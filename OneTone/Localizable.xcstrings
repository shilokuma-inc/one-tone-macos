    "Loud sounds and high frequencies can damage your hearing and your speakers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laute Töne und hohe Frequenzen können dein Gehör und deine Lautsprecher schädigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sonidos fuertes y las frecuencias altas pueden dañar tu audición y tus altavoces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sons forts et les hautes fréquences peuvent endommager votre audition et vos haut-parleurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara keras dan frekuensi tinggi dapat merusak pendengaran dan speaker Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoni forti e le frequenze alte possono danneggiare l’udito e gli altoparlanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな音や高い周波数の音は、聴覚やスピーカーを傷めるおそれがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 소리와 높은 주파수는 청력과 스피커를 손상시킬 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sons altos e frequências elevadas podem prejudicar sua audição e seus alto-falantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкие звуки и высокие частоты могут повредить ваш слух и динамики."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "响亮的声音和高频声音可能会损伤你的听力和扬声器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "響亮的聲音和高頻聲音可能會損傷你的聽力和揚聲器。"
          }
        }
      }
    },
