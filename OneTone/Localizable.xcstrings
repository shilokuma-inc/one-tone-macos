      }
    },
    "To prevent a sudden loud sound, the volume was lowered to %lld%%." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "突然大きな音が出ないよう、音量を %lld%% に下げました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为避免突然发出很大的声音，已将音量调低至 %lld%%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為避免突然發出很大的聲音，已將音量調低至 %lld%%。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갑자기 큰 소리가 나지 않도록 음량을 %lld%%로 낮췄습니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar un sonido fuerte repentino, el volumen se ha reducido al %lld %%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour éviter un son fort soudain, le volume a été réduit à %lld %%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein plötzliches lautes Geräusch zu vermeiden, wurde die Lautstärke auf %lld %% verringert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per evitare un suono forte improvviso, il volume è stato abbassato al %lld%%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar um som alto repentino, o volume foi reduzido para %lld%%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы не прозвучал внезапно громкий звук, громкость уменьшена до %lld %%."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mencegah suara keras yang tiba-tiba, volume diturunkan menjadi %lld%%."
          }
        }
      }
    },
    "Use the volume control to set how loud the tone is. Start low and turn it up gradually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle mit dem Lautstärkeregler ein, wie laut der Ton ist. Beginne leise und erhöhe die Lautstärke nach und nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el control de volumen para ajustar la intensidad del tono. Empieza bajo y súbelo poco a poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la commande de volume pour régler l’intensité du son. Commencez bas et montez progressivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan kontrol volume untuk mengatur kerasnya nada. Mulailah dari pelan lalu naikkan secara bertahap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il controllo del volume per impostare l’intensità del tono. Parti basso e alzalo gradualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量のつまみで音の大きさを決めます。小さい音から始めて、少しずつ上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음량 컨트롤로 톤의 크기를 설정하세요. 작은 음량에서 시작해 조금씩 높이세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o controle de volume para definir a intensidade do tom. Comece baixo e aumente aos poucos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С помощью регулятора громкости задайте громкость тона. Начните с тихого звука и повышайте постепенно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用音量控制来设定音调的响度。请从低音量开始，再逐渐调高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用音量控制來設定音調的響度。請從低音量開始，再逐漸調高。"
          }
        }
      }
    },
